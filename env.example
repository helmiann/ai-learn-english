# ============================================================
#  ENGLISH GRAMMAR CHATBOT — Environment Variables
#  Salin file ini menjadi .env lalu isi nilainya
#  JANGAN pernah commit file .env ke GitHub!
# ============================================================

# ------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti_password_ini
POSTGRES_DB=grammar_chatbot
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL lengkap untuk SQLAlchemy (diisi otomatis dari nilai di atas)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------
# REDIS (Cache)
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ------------------------------------------------------------
# KEAMANAN & JWT
# ------------------------------------------------------------
# Ganti dengan string acak yang panjang dan kuat
# Bisa generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti_dengan_secret_key_yang_kuat_dan_acak
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------
# LLAMA AI API
# ------------------------------------------------------------
LLAMA_API_URL=https://api.example-llama-provider.com/v1
LLAMA_API_KEY=llm-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLAMA_MODEL=llama-3-8b-instruct
LLAMA_MAX_TOKENS=2048
LLAMA_TEMPERATURE=0.7

# ------------------------------------------------------------
# APLIKASI
# ------------------------------------------------------------
APP_NAME=English Grammar Chatbot
APP_ENV=development
# development | production
DEBUG=true
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
LOG_LEVEL=INFO
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FILE=logs/app/app.log
